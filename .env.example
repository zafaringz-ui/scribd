# Copy this file to .env and fill in only the settings you use.
# Never commit .env or paste real credentials into logs or chat.

# Discord bot (needed only when running discord_bot.py)
DISCORD_TOKEN=
ALLOWED_GUILD_IDS=

# Web UI: auto generates and persists a private access token; use "off" only
# when the service is protected by another access-control layer.
WEB_TOKEN=auto
PUBLIC_HOST=

# Optional Scribd session cookies for documents requiring login.
SCRIBD_COOKIES=

# Optional Drime Cloud offload. Uploaded PDFs are deleted locally on success
# unless DRIME_KEEP=1.
DRIME_API_KEY=
DRIME_FOLDER=
DRIME_SHARE=0
DRIME_PART_MB=5
DRIME_KEEP=0

# Optional: point at a preinstalled Chromium executable.
SCRIBD_CHROMIUM=
